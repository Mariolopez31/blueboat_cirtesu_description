<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="blueboat">

  <xacro:arg name="environment" default="real"/>
  <xacro:arg name="lookup_csv" default=""/>
  <xacro:arg name="pwm_channels" default="0,2"/>
  <xacro:arg name="status_light_channel" default="1"/>
  <xacro:arg name="stonefish_topic" default="/catamaran/controller/thruster_setpoints_sim"/>
  <xacro:arg name="gps_protocol" default="ubx"/>
  <xacro:arg name="gps_serial_port" default="/dev/ttyAMA5"/>
  <xacro:arg name="gps_baudrate" default="230400"/>

  <xacro:macro name="blueboat_thrusters_macro" params="prefix environment">

    <xacro:property name="thruster_yaw" value="${0.0 if environment == 'sim' else 3.14159265}"/>
    <xacro:property name="left_thruster_y" value="${-0.28 if environment == 'sim' else -0.3}"/>
    <xacro:property name="right_thruster_y" value="${0.28 if environment == 'sim' else 0.3}"/>

    <link name="${prefix}base_link"/>

    <link name="${prefix}left_thruster_link"/>
    <joint name="${prefix}left_thruster_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}left_thruster_link"/>
      <origin xyz="-0.472 ${left_thruster_y} 0.0245" rpy="0.0 0.0 ${thruster_yaw}"/>
    </joint>

    <link name="${prefix}right_thruster_link"/>
    <joint name="${prefix}right_thruster_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}right_thruster_link"/>
      <origin xyz="-0.472 ${right_thruster_y} 0.0245" rpy="0.0 0.0 ${thruster_yaw}"/>
    </joint>

    <link name="${prefix}imu_link"/>
    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="gps_frame"/>
    <joint name="${prefix}gps_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="gps_frame"/>
      <origin xyz="0.39 -0.36 -0.05" rpy="3.1416 0 1.57"/>
    </joint>

    <link name="${prefix}status_light_link"/>
    <joint name="${prefix}status_light_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}status_light_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <xacro:blueboat_thrusters_macro prefix="blueboat/" environment="$(arg environment)"/>

  <ros2_control name="ThrustersSystem" type="system">
    <hardware>
      <plugin>sura_hardware_interface/ThrustersSystem</plugin>
      <param name="environment">$(arg environment)</param>
      <param name="lookup_csv">$(arg lookup_csv)</param>
      <param name="pwm_channels">$(arg pwm_channels)</param>
      <param name="stonefish_topic">$(arg stonefish_topic)</param>
    </hardware>

    <joint name="blueboat/left_thruster_joint">
      <command_interface name="effort"/>
      <state_interface name="effort"/>
      <param name="inverted">false</param>
    </joint>

    <joint name="blueboat/right_thruster_joint">
      <command_interface name="effort"/>
      <state_interface name="effort"/>
      <param name="inverted">true</param>
    </joint>
  </ros2_control>

  <ros2_control name="ActuatorsSystem" type="system">
    <hardware>
      <plugin>sura_hardware_interface/ActuatorsSystem</plugin>
      <param name="environment">$(arg environment)</param>
      <param name="status_light_channel">$(arg status_light_channel)</param>
    </hardware>

    <joint name="blueboat/status_light_joint">
      <command_interface name="enabled"/>
      <state_interface name="enabled"/>
    </joint>
  </ros2_control>

  <ros2_control name="SensorsSystem" type="system">
    <hardware>
      <plugin>sura_hardware_interface/SensorsSystem</plugin>
      <param name="environment">$(arg environment)</param>
      <param name="gps_protocol">$(arg gps_protocol)</param>
      <param name="gps_serial_port">$(arg gps_serial_port)</param>
      <param name="gps_baudrate">$(arg gps_baudrate)</param>
    </hardware>

    <sensor name="imu_sensor">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>

    <sensor name="magnetometer_sensor">
      <state_interface name="magnetic_field.x"/>
      <state_interface name="magnetic_field.y"/>
      <state_interface name="magnetic_field.z"/>
    </sensor>

    <sensor name="battery_sensor">
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="present"/>
    </sensor>

    <sensor name="gps_sensor">
      <state_interface name="gps.latitude"/>
      <state_interface name="gps.longitude"/>
      <state_interface name="gps.altitude"/>
      <state_interface name="gps.valid"/>
    </sensor>
  </ros2_control>

</robot>
